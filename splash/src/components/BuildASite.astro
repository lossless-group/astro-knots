---
// "Build a site": the copy-a-prompt setup for astro-knots-mcp, plus the
// install commands for people who'd rather run them by hand.
// Styles live here: the homepage's section styles are scoped to its own file.
import { INSTALL, MCP_REPO_URL, MCP_URL, setupPrompt } from '@lib/astro-knots-mcp';

const prompt = setupPrompt();
const guardrails = [
  'Astro, with Svelte only where it needs to be interactive',
  'No React, no JSX habits: checked on every edit',
  'Markdown through Lossless Flavored Markdown',
  'Tests first, with Vitest',
  'Light, dark and vibrant modes from two-tier tokens',
  'Share images that fit iMessage, WhatsApp and the feeds',
  'Rapid creativity, followed up by strong refactors',
  'Design system and component library, maintained',
];
---

<section id="build-a-site" class="section build">
  <div class="container">
    <header class="build__head">
      <p class="eyebrow">Build one yourself</p>
      <h2 class="display build__title">Tie your own knot, <span class="gradient-text">with your agent.</span></h2>
      <p class="build__lede">
        The patterns behind these sites, packaged for Claude Code and Codex: skills your agent loads
        when it needs them, and a check that catches React habits the moment they're written. Paste
        one prompt and your agent sets itself up, then asks what you're building.
      </p>
    </header>

    <div class="build__grid">
      <div class="build__col">
        <div class="build__step">
          <span class="build__num mono" aria-hidden="true">1</span>
          <h3 class="build__step-title"><label for="setup-prompt">Copy this prompt into your agent</label></h3>
        </div>

        <div class="prompt-card">
          <div class="prompt-card__bar">
            <span class="prompt-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="prompt-card__name mono">setup prompt</span>
            <button type="button" class="build__copy mono" data-copy-target="setup-prompt" aria-live="polite">
              <svg class="build__copy-icon build__copy-icon--copy" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
                <path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path>
              </svg>
              <svg class="build__copy-icon build__copy-icon--done" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5"></path>
              </svg>
              <span class="build__copy-text">Copy prompt</span>
            </button>
          </div>
          <textarea id="setup-prompt" class="prompt-card__text mono" readonly rows="12">{prompt}</textarea>
          <p class="prompt-card__foot">
            Works in the Claude Code CLI, the Codex CLI and the ChatGPT desktop app (not Codex's IDE
            extension). Along the way it'll suggest an Ideogram key, so your agent can keep making images
            that match your site.
          </p>
        </div>
      </div>

      <div class="build__col">
        <div class="build__step">
          <span class="build__num mono" aria-hidden="true">2</span>
          <h3 class="build__step-title">Or install it yourself</h3>
        </div>

        <article class="install">
          <h4 class="install__name">Claude Code</h4>
          <pre class="install__code mono"><code>{INSTALL.claudeCode.join('\n')}</code></pre>
        </article>

        <article class="install">
          <h4 class="install__name">Codex</h4>
          <pre class="install__code mono"><code>{INSTALL.codex.join('\n')}</code></pre>
          <p class="install__note">Codex runs a plugin's hooks only once you've trusted them in <code>/hooks</code>.</p>
        </article>

        {MCP_URL && (
          <article class="install">
            <h4 class="install__name">Any MCP client</h4>
            <pre class="install__code mono"><code>{MCP_URL}</code></pre>
            <p class="install__note">A remote server with no sign-in. It stores nothing about you.</p>
          </article>
        )}
      </div>
    </div>

    <div class="build__gets">
      <p class="eyebrow">What your agent follows</p>
      <ul class="build__list">
        {guardrails.map((g) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
            <span>{g}</span>
          </li>
        ))}
      </ul>
      <a href={MCP_REPO_URL} target="_blank" rel="noopener" class="build__repo mono">astro-knots-mcp on GitHub →</a>
    </div>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-target]')) {
    button.addEventListener('click', async () => {
      const target = document.getElementById(button.dataset.copyTarget ?? '') as HTMLTextAreaElement | null;
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.value);
      } catch {
        target.select();
        document.execCommand('copy');
      }
      const label = button.querySelector('.build__copy-text');
      button.classList.add('is-copied');
      if (label) label.textContent = 'Copied. Now paste it';
      setTimeout(() => {
        button.classList.remove('is-copied');
        if (label) label.textContent = 'Copy prompt';
      }, 2500);
    });
  }
</script>

<style>
  /* Head */
  .build__head { max-width: 720px; margin-bottom: var(--space-12); }
  .build__title { margin-top: var(--space-3); font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.05; }
  .build__lede { margin-top: var(--space-4); max-width: 62ch; color: var(--color-text-soft); font-size: 1.05rem; line-height: 1.6; }

  /* Two columns, step headers on one baseline */
  .build__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  @media (max-width: 900px) {
    .build__grid { grid-template-columns: minmax(0, 1fr); }
  }
  .build__col { display: flex; flex-direction: column; gap: var(--space-4); }
  .build__step { display: flex; align-items: center; gap: var(--space-3); min-height: 32px; }
  .build__num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-bg);
    background: var(--gradient-thread);
    flex-shrink: 0;
  }
  .build__step-title { font-family: var(--font__sans); font-size: 1rem; font-weight: 600; color: var(--color-text); }
  .build__step-title label { cursor: text; }

  /* The prompt, in a card with its own toolbar */
  .prompt-card {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-card);
    overflow: hidden;
  }
  .prompt-card__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 10px 10px 16px;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-text) 4%, transparent);
  }
  .prompt-card__dots { display: inline-flex; gap: 6px; }
  .prompt-card__dots i {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-text) 18%, transparent);
  }
  .prompt-card__name { font-size: 0.75rem; color: var(--color-text-dim); letter-spacing: 0.04em; margin-right: auto; }
  .prompt-card__text {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 16rem;
    padding: var(--space-4) var(--space-6);
    border: 0;
    resize: vertical;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--color-text);
    background: transparent;
  }
  .prompt-card__text:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .prompt-card__foot {
    margin: 0;
    padding: var(--space-3) var(--space-6) var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  /* Copy button */
  .build__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 16px 8px 12px;
    border: 0;
    border-radius: 999px;
    background: var(--gradient-thread);
    color: var(--color-bg);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: var(--shadow-glow);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .build__copy:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 32px color-mix(in oklab, var(--color-accent) 35%, transparent);
  }
  .build__copy:active { transform: translateY(0); }
  .build__copy:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .build__copy-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .build__copy-icon--done { display: none; }
  .build__copy.is-copied .build__copy-icon--copy { display: none; }
  .build__copy.is-copied .build__copy-icon--done { display: block; }

  /* Install cards */
  .install {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
  }
  .install__name { font-family: var(--font__sans); font-size: 0.95rem; font-weight: 600; margin-bottom: var(--space-2); }
  .install__code {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-accent);
  }
  .install__note { margin-top: var(--space-3); font-size: 0.82rem; color: var(--color-text-soft); }
  .install__note code { font-family: var(--font__mono); color: var(--color-accent); }

  /* What your agent follows: full width, under both columns */
  .build__gets {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .build__list {
    list-style: none;
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-3) var(--space-6);
  }
  .build__list li { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--color-text); line-height: 1.5; }
  .build__list svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .build__repo { font-size: 0.85rem; color: var(--color-thread); }

  @media (prefers-reduced-motion: reduce) {
    .build__copy, .build__copy:hover { transition: none; transform: none; }
  }
</style>
