---
// CodeBlock — fenced code inside LFM-rendered content, colored by LFM's own
// highlighter (@lossless-group/lfm/highlight, from 0.7.0).
//
// Astro's built-in Shiki never sees these blocks: our content goes
// LFM -> MDAST -> AstroMarkdown -> here. highlightCode colors the tokens with
// a palette whose lightness follows the site's --color-text, so it works in
// light, dark and vibrant with no setup. To match a brand, set
// --lfm-code-token-keyword (and friends) in the site's theme CSS.
//
// Colors here read the site's semantic tokens, with fallbacks, so the block
// sits on the page's own background in every mode. Never a fixed dark box:
// the token palette is lit for the page, not for a navy panel.
import { highlightCode } from '@lossless-group/lfm/highlight';

export interface Props {
  language?: string;
  code: string;
  meta?: string;
}

const { language, code } = Astro.props as Props;

// The author's own fence label, if they gave one.
const langLabel = language?.trim() ? language.trim().toUpperCase() : undefined;
const html = await highlightCode(code, language);
---

<div class="ak-codeblock-wrap">
  <div class="ak-codeblock-chrome">
    {langLabel && <span class="ak-codeblock-lang">{langLabel}</span>}
    <button class="ak-codeblock-copy" type="button" aria-label="Copy code to clipboard" data-copy-btn>
      Copy
    </button>
  </div>
  <pre class="ak-codeblock"><code set:html={html} /></pre>
</div>

<script>
  // One delegated listener for every code block on the page.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-copy-btn]') as HTMLButtonElement | null;
    if (!btn) return;
    const code = btn.closest('.ak-codeblock-wrap')?.querySelector('pre code')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Press ⌘C';
    }
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>

<style>
  .ak-codeblock-wrap {
    margin: 0 0 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, color-mix(in oklab, currentColor 16%, transparent));
    background: var(--color-bg-code, color-mix(in oklab, var(--color-text, currentColor) 5%, transparent));
    overflow: hidden;
  }

  /* A real header row, not an overlay: an overlay sits on the first line of code. */
  .ak-codeblock-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    padding: 0.375rem 0.625rem 0.375rem 0.875rem;
    border-bottom: 1px solid var(--color-border, color-mix(in oklab, currentColor 16%, transparent));
    background: color-mix(in oklab, var(--color-text, currentColor) 4%, transparent);
  }
  /* Keeps Copy hard right when a block has no language label. */
  .ak-codeblock-chrome > :only-child { margin-left: auto; }

  .ak-codeblock-lang,
  .ak-codeblock-copy {
    font-family: var(--font-code, var(--font__mono, ui-monospace, SFMono-Regular, Menlo, monospace));
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-dim, color-mix(in oklab, currentColor 60%, transparent));
  }
  .ak-codeblock-lang { pointer-events: none; }
  .ak-codeblock-copy {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.3125rem;
    padding: 0.1875rem 0.5rem;
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .ak-codeblock-copy:hover,
  .ak-codeblock-copy:focus-visible {
    color: var(--color-text, currentColor);
    border-color: var(--color-border, color-mix(in oklab, currentColor 16%, transparent));
  }

  .ak-codeblock {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    background: transparent;
    color: var(--lfm-code-foreground, var(--color-text, currentColor));
  }
  .ak-codeblock code {
    display: block;
    background: transparent;
    padding: 0;
    font-family: var(--font-code, var(--font__mono, ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", "Courier New", monospace));
  }
  /* Shiki separates lines with a literal newline; inside <pre> that already
     breaks the line, so line spans stay inline or every block double-spaces. */
  .ak-codeblock :global(.line) { display: inline; }

  @media (prefers-reduced-motion: reduce) {
    .ak-codeblock-copy { transition: none; }
  }
</style>
