---
// Every repo's splash page across the lossless-monorepo tree: each repo's own
// front page on GitHub Pages or Vercel, built with the maintain-splash-pages
// pattern. Cards live in src/content/splash-highlights/.
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import HighlightGrid from '@components/HighlightGrid.astro';
import KnotMarkRing from '@components/KnotMarkRing.astro';
import ModeToggle from '@components/ModeToggle.astro';
import { STATIC_SEO } from '@lib/seo';

const base = import.meta.env.BASE_URL;
const splashes = await getCollection('splash-highlights');
---

<BaseLayout title={STATIC_SEO.splashesIndex.title} description={STATIC_SEO.splashesIndex.description}>
  <header class="archive-topbar">
    <div class="container archive-topbar__inner">
      <a class="archive-topbar__brand" href={base}>
        <KnotMarkRing size={28} static />
        <span class="mono">astro-knots</span>
      </a>
      <ModeToggle />
    </div>
  </header>

  <main class="container archive">
    <header class="archive__head">
      <p class="eyebrow">Front pages</p>
      <h1 class="display">The splash pages</h1>
      <p class="archive__lede">
        {splashes.length} repos with a front page of their own: what each one is, its changelog and its
        working notes, built from Astro Knots patterns. Every one looks different on purpose.
      </p>
      <p class="archive__back mono">
        <a href={base}>← Back to splash</a>
        <span class="dim"> · </span>
        <a href={`${base}sites/`}>See the sites →</a>
      </p>
    </header>

    <HighlightGrid items={splashes} />
  </main>
</BaseLayout>

<style>
  .archive-topbar {
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
    background: color-mix(in oklab, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .archive-topbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }
  .archive-topbar__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }
  .archive { padding: clamp(3rem, 8vh, 6rem) 0 var(--space-16); }
  .archive__head { margin-bottom: var(--space-12); max-width: 720px; }
  .archive__head h1 { margin-top: var(--space-3); font-size: clamp(2.25rem, 5vw, 3.5rem); }
  .archive__lede { margin-top: var(--space-4); color: var(--color-text-soft); font-size: 1.05rem; }
  .archive__back { margin-top: var(--space-6); font-size: 0.875rem; }
  .archive__back .dim { color: var(--color-text-dim); }
</style>
