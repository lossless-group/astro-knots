---
// The family of sites built on Astro Knots patterns. Moved off the homepage
// so the homepage can lead with what Astro Knots is for.
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import HighlightGrid from '@components/HighlightGrid.astro';
import KnotMarkRing from '@components/KnotMarkRing.astro';
import ModeToggle from '@components/ModeToggle.astro';
import { STATIC_SEO } from '@lib/seo';

const base = import.meta.env.BASE_URL;
const sites = await getCollection('site-highlights');
---

<BaseLayout title={STATIC_SEO.sitesIndex.title} description={STATIC_SEO.sitesIndex.description}>
  <header class="archive-topbar">
    <div class="container archive-topbar__inner">
      <a class="archive-topbar__brand" href={base}>
        <KnotMarkRing size={28} static />
        <span class="mono">astro-knots</span>
      </a>
      <ModeToggle />
    </div>
  </header>

  <main class="container archive">
    <header class="archive__head">
      <p class="eyebrow">The lattice</p>
      <h1 class="display">The sites</h1>
      <p class="archive__lede">
        {sites.length} sites built on these patterns. Each is its own repo and deploys on its own; each
        card carries a thread in that site's brand color, a reminder that nothing's actually merged.
      </p>
      <p class="archive__back mono">
        <a href={base}>← Back to splash</a>
        <span class="dim"> · </span>
        <a href={`${base}splashes/`}>See the splash pages →</a>
      </p>
    </header>

    <HighlightGrid items={sites} />
  </main>
</BaseLayout>

<style>
  .archive-topbar {
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
    background: color-mix(in oklab, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .archive-topbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }
  .archive-topbar__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }
  .archive { padding: clamp(3rem, 8vh, 6rem) 0 var(--space-16); }
  .archive__head { margin-bottom: var(--space-12); max-width: 720px; }
  .archive__head h1 { margin-top: var(--space-3); font-size: clamp(2.25rem, 5vw, 3.5rem); }
  .archive__lede { margin-top: var(--space-4); color: var(--color-text-soft); font-size: 1.05rem; }
  .archive__back { margin-top: var(--space-6); font-size: 0.875rem; }
  .archive__back .dim { color: var(--color-text-dim); }
</style>
